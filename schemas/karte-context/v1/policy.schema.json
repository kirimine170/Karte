{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karte.local/schemas/karte-context/v1/policy.schema.json",
  "title": "Karte Context Policy V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "actors"],
  "properties": {
    "protocol_version": { "const": "1.0" },
    "master_projects": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }
    },
    "actors": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/actorPolicy" }
    }
  },
  "$defs": {
    "actorPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensitivity_ceiling", "projects"],
      "properties": {
        "sensitivity_ceiling": { "enum": ["public", "internal", "confidential", "restricted"] },
        "projects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(\\*|[a-z0-9][a-z0-9._-]{0,63})$" }
        },
        "allowed_tags": { "$ref": "#/$defs/tags" },
        "denied_tags": { "$ref": "#/$defs/tags" },
        "provenance_types": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(\\*|[a-z0-9][a-z0-9._-]{0,63})$" }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["search", "read", "propose", "review", "export", "learn"] }
        }
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    }
  }
}
