{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karte.local/schemas/karte-context/v1/audit.schema.json",
  "title": "Karte Context Audit Event V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["audit_version", "event_id", "correlation_sha256", "actor_type", "actor_id_sha256", "operation", "status", "result_count", "recorded_at"],
  "properties": {
    "audit_version": { "const": "1.0" },
    "event_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "correlation_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "actor_type": { "enum": ["ephy", "human", "tool", "unknown"] },
    "actor_id_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "operation": { "enum": ["search", "read", "propose", "review", "export", "learn", "invalid"] },
    "status": { "enum": ["allowed", "denied", "ok", "not_found", "invalid", "conflict", "error"] },
    "result_count": { "type": "integer", "minimum": 0 },
    "error_code": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "recorded_at": { "type": "string", "format": "date-time" }
  }
}
