{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ephy.local/schemas/karte-ephy/v1/proposal.schema.json",
  "title": "Karte change proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "operation",
    "target_doc_id",
    "target_relative_path",
    "base_sha256",
    "proposed_frontmatter",
    "proposed_body",
    "source_refs",
    "sensitivity",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "operation": {
      "enum": [
        "create",
        "update"
      ]
    },
    "target_doc_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "target_relative_path": {
      "type": "string",
      "minLength": 12,
      "maxLength": 1024,
      "pattern": "^content/[^\\\\]+\\.md$",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      }
    },
    "base_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposed_frontmatter": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": true
    },
    "proposed_body": {
      "type": "string",
      "maxLength": 1048576
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "reference"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "create"
          }
        }
      },
      "then": {
        "properties": {
          "target_doc_id": {
            "type": "null"
          },
          "base_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "update"
          }
        }
      },
      "then": {
        "properties": {
          "target_doc_id": {
            "type": "string",
            "minLength": 1
          },
          "base_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  ]
}
