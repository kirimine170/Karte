{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kirimine170/Karte/main/schemas/karte-ephy/v2/grant.schema.json",
  "title": "Karte Runtime records v2 grant",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "policy_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "policy_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "enabled": {
      "type": "boolean"
    },
    "user_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "producer_instance_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "scope_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "storage_area_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "records": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 3,
      "additionalProperties": false,
      "properties": {
        "conversation": {
          "$ref": "#/$defs/classification"
        },
        "summary": {
          "$ref": "#/$defs/classification"
        },
        "ephy_diary": {
          "$ref": "#/$defs/classification"
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "enum": [
          "create_record",
          "append_events",
          "revise_derivation"
        ]
      },
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true
    },
    "denied_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "consent_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "scope_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "storage": {
      "const": true
    },
    "training": {
      "const": false
    },
    "external_transfer": {
      "const": false
    },
    "key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "policy_revision",
    "enabled",
    "user_id",
    "actor_id",
    "producer_instance_id",
    "scope_id",
    "storage_area_id",
    "project",
    "records",
    "operations",
    "denied_tags",
    "valid_from",
    "consent_epoch",
    "scope_generation",
    "storage",
    "training",
    "external_transfer",
    "key_id"
  ],
  "$defs": {
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "note",
            "journal"
          ]
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "provenance_types": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "sensitivity",
        "tags",
        "provenance_types"
      ]
    }
  }
}
