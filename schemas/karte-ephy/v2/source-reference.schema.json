{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kirimine170/Karte/main/schemas/karte-ephy/v2/source-reference.schema.json",
  "title": "Karte Runtime records v2 source-ref",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "doc_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "conversation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "turn_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "not": {
          "const": "00000000-0000-0000-0000-000000000000"
        }
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event-ref"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    }
  },
  "required": [
    "doc_id",
    "revision",
    "sha256",
    "conversation_id",
    "turn_ids",
    "events"
  ],
  "$defs": {
    "event-ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "event_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "event_id",
        "event_revision"
      ]
    }
  }
}
