{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Karte personal Markdown package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "root_resource_id", "root_revision_id", "blob"],
  "properties": {
    "format_version": {"const": "0.1"},
    "root_resource_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": {"pattern": "^decision-[0-9a-f]{64}$"}
    },
    "root_revision_id": {"$ref": "#/$defs/digest"},
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size", "media_type"],
      "properties": {
        "sha256": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 1, "maximum": 2097152},
        "media_type": {"const": "text/markdown"}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
  }
}
