{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ephy.local/schemas/experiment/v0.1/record.schema.json",
  "title": "Karte Ephy experiment record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "experiment_id",
    "run_id",
    "attempt_id",
    "target_commit",
    "patch_sha256",
    "environment",
    "model",
    "checker",
    "observations",
    "interpretation",
    "halt_reason",
    "evidence",
    "verification",
    "state",
    "project",
    "title",
    "reported_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "target_commit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-f0-9]{40}$|^unacquired$"
    },
    "patch_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$|^unacquired$"
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\r\\n]+$"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\r\\n]+$"
    },
    "checker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\r\\n]+$"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "interpretation": {
      "type": "string",
      "maxLength": 2048
    },
    "halt_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logical_ref",
          "sha256"
        ],
        "properties": {
          "logical_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^(?!manifest\\.json(?:/|$))(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)[^/]*\\.(?:/|$))[a-z0-9][a-z0-9._-]*(?:/[a-z0-9._-]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "verification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(verified|unverified|unacquired)$"
    },
    "state": {
      "type": "string",
      "enum": [
        "saved",
        "experiment",
        "adopted"
      ]
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "reported_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
