# npm設定ファイル
# プラットフォーム間の一貫性を保つための設定

# package-lock.jsonを厳密に使用
package-lock=true

# オプショナル依存関係をインストール（プラットフォーム固有の依存関係を含む）
# これにより、package-lock.jsonにすべてのプラットフォームの情報が含まれる
optional=true

# ログレベル
loglevel=warn

# エラーハンドリング
audit=false

# プラットフォーム固有の情報を統一するため、すべてのオプショナル依存関係を含める
# これにより、MacとWindowsで同じpackage-lock.jsonが生成される
save-exact=false

