  "observeOnlyProfiles": [
    {
      "id": "native_idle_process",
      "scenario": "idle",
      "metrics": ["rss_bytes", "cpu_seconds"],
      "reason": "Process RSS and CPU depend on the OS，allocator，desktop runtime，and runner load.",
      "procedure": "Build a release desktop artifact，launch it with an empty fixed data directory，warm for sixty seconds，then capture five ten-second samples with the platform process monitor."
    },
    {
      "id": "native_asr_llm",
      "scenario": "concurrent_heavy",
      "metrics": ["rss_bytes", "cpu_seconds", "latency_milliseconds"],
      "reason": "Native model runtimes，model files，and hardware acceleration are unavailable and unstable in the PR fixture；a production local LLM callsite is not implemented.",
      "procedure": "After a local LLM callsite exists，pin both model digests and native runtimes，warm each model once，run simultaneous fixed inputs five times，and attach the raw report without changing this baseline automatically."
    },
    {
      "id": "browser_pdf_graph",
      "scenario": "browser_rendering",
      "metrics": ["browser_heap_bytes", "paint_milliseconds", "gpu_memory_bytes"],
      "reason": "jsdom has no browser layout，raster，paint，or GPU pipeline.",
      "procedure": "Run a pinned Chromium build against a release artifact，warm each fixture twice，record five samples through the browser performance trace，and attach the trace as an observe-only artifact."
    }
  ]
